rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only access their own data, admin can access all
    match /users/{userId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || request.auth.token.email == 'admin@supercoin.com');
      
      // User subcollections
      match /{subcollection=**} {
        allow read, write: if request.auth != null && 
          (request.auth.uid == userId || request.auth.token.email == 'admin@supercoin.com');
      }
    }
    
    // Orders collection - users can create orders for themselves, admin can access all
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.email == 'admin@supercoin.com');
      allow create: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
    
    // Withdrawals collection - users can create withdrawals for themselves, admin can access all
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.email == 'admin@supercoin.com');
      allow create: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
    
    // Deposit requests collection - users can create deposits for themselves, admin can access all
    match /depositRequests/{depositId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.email == 'admin@supercoin.com');
      allow create: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
    
    // Invitations collection - readable by all authenticated users, writable by admin only
    match /invitations/{invitationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
    
    // Announcements collection - readable by all authenticated users, writable by admin only
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
    
    // Platform settings collection - readable by all authenticated users, writable by admin only
    match /platformSettings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@supercoin.com';
    }
  }
}
